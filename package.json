{
  "name": "sumlyzer",
  "version": "1.3.1",
  "description": "Run every npm workspace's test script, only show output for the ones that fail, and finish with an aggregated pass/fail summary.",
  "type": "module",
  "bin": {
    "sumlyzer": "bin/sumlyzer.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"./test/*.spec.mjs\"",
    "pretest:coverage": "mkdir -p coverage",
    "test:coverage": "node --no-warnings --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=85 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test \"./test/*.spec.mjs\"",
    "security-scan": "node scripts/security-scan.mjs",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm test",
    "release": "npm publish --dry-run"
  },
  "keywords": [
    "npm workspaces test output",
    "npm workspaces logs",
    "node test runner",
    "node --test",
    "monorepo test output",
    "workspace test logs",
    "parallel test output",
    "npm test readability",
    "cli",
    "junit",
    "junit-xml",
    "github-actions",
    "monorepo"
  ],
  "author": {
    "name": "Erwan Raulo",
    "url": "https://github.com/ErwanRaulo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErwanRaulo/sumlyzer.git"
  },
  "bugs": {
    "url": "https://github.com/ErwanRaulo/sumlyzer/issues"
  },
  "homepage": "https://github.com/ErwanRaulo/sumlyzer#readme",
  "devDependencies": {
    "@nodesecure/js-x-ray": "^16.0.0",
    "@types/node": "^26.1.1",
    "fast-xml-parser": "^5.10.1"
  },
  "dependencies": {
    "glob": "^13.0.6"
  }
}
