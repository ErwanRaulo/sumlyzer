{
  "name": "sumlyzer",
  "version": "1.0.1",
  "description": "Run every npm workspace's test script, only show output for the ones that fail, and finish with an aggregated pass/fail summary.",
  "type": "module",
  "bin": {
    "sumlyzer": "bin/sumlyzer.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"./test/*.spec.mjs\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 95 --functions 95 --statements 95 --branches 85 node --test \"./test/*.spec.mjs\"",
    "security-scan": "node scripts/security-scan.mjs",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm test",
    "release": "npm publish --dry-run"
  },
  "keywords": [
    "npm workspaces test output",
    "npm workspaces logs",
    "node test runner",
    "node --test",
    "monorepo test output",
    "workspace test logs",
    "parallel test output",
    "npm test readability",
    "cli",
    "junit",
    "junit-xml",
    "github-actions",
    "monorepo"
  ],
  "author": {
    "name": "Erwan Raulo",
    "url": "https://github.com/ErwanRaulo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErwanRaulo/sumlyzer.git"
  },
  "bugs": {
    "url": "https://github.com/ErwanRaulo/sumlyzer/issues"
  },
  "homepage": "https://github.com/ErwanRaulo/sumlyzer#readme",
  "devDependencies": {
    "@nodesecure/js-x-ray": "^16.0.0",
    "@types/node": "^26.1.1",
    "c8": "^12.0.0",
    "fast-xml-parser": "^5.10.1"
  },
  "dependencies": {
    "glob": "^13.0.6"
  }
}
